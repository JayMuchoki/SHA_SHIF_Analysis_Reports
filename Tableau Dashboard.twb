    <worksheet name='Approval and Rejection rate across time'>
      <table>
        <view>
          <datasources>
            <datasource caption='Contributions+ (Excel Tableau tables)' name='federated.0iy6fio1n0pzv71ccy9ht15ywd89' />
          </datasources>
          <datasource-dependencies datasource='federated.0iy6fio1n0pzv71ccy9ht15ywd89'>
            <column caption='Approval Rate' datatype='real' name='[Calculation_1308014222692319236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [claim_status]= &quot;Approved&quot; THEN 1 ELSE 0 END) &#13;&#10;/&#13;&#10;COUNT([claim_amount]) * 100' />
            </column>
            <column caption='Rejection Rate' datatype='real' name='[Calculation_1308014222694371333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [claim_status] = &quot;Rejected&quot; THEN 1 ELSE 0 END) &#13;&#10;/&#13;&#10;COUNT([claim_amount]) * 100' />
            </column>
            <column caption='Claim Amount' datatype='real' name='[claim_amount]' role='measure' type='quantitative' />
            <column caption='Claim Status' datatype='string' name='[claim_status]' role='dimension' type='nominal' />
            <column-instance column='[payment_date]' derivation='Month' name='[mn:payment_date:ok]' pivot='key' type='ordinal' />
