      <aliases enabled='yes' />
      <column caption='Age Group' datatype='string' name='[Calculation_1308014222410833921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;= 25 THEN &apos;18-25&apos;&#13;&#10;ELSEIF [age] &lt;= 35 THEN &apos;26-35&apos;&#13;&#10;ELSEIF  [age]&lt;= 45 THEN &apos;36-45&apos;&#13;&#10;ELSEIF [age] &lt;= 55 THEN &apos;46-55&apos;&#13;&#10;ELSEIF [age] &lt;= 65 THEN &apos;56-65&apos;&#13;&#10;ELSE &apos;66-80&apos;&#13;&#10;END' />
      </column>
      <column caption='Drop_Outs' datatype='integer' name='[Calculation_1308014222424494082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nhif_migrated] = True THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Non_Dropouts' datatype='integer' name='[Calculation_1308014222435901443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [nhif_migrated] = False Then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Approval Rate' datatype='real' name='[Calculation_1308014222692319236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [claim_status]= &quot;Approved&quot; THEN 1 ELSE 0 END) &#13;&#10;/&#13;&#10;COUNT([claim_amount]) * 100' />
      </column>
      <column caption='Rejection Rate' datatype='real' name='[Calculation_1308014222694371333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [claim_status] = &quot;Rejected&quot; THEN 1 ELSE 0 END) &#13;&#10;/&#13;&#10;COUNT([claim_amount]) * 100' />
      </column>
      <column caption='Total Approvals' datatype='integer' name='[Calculation_1308014222698696710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Approved&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Rejection' datatype='integer' name='[Calculation_1308014222699057159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [claim_status] = &quot;Rejected&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='subsidized' datatype='real' name='[Calculation_1308014222720806921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_subsidized] = True Then 1 ELSE 0 END)/&#13;&#10;COUNT([member_id (Members)])' />
      </column>
      <column caption='avg. utilization' datatype='real' name='[Calculation_1308014222727770123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([service_type]) / countd([service_type])' />
      </column>
      <column caption='Claims' datatype='table' name='[__tableau_internal_object_id__].[Claims_7D0A2A6EFCFB47DC91AFE0402008F008]' role='measure' type='quantitative' />
